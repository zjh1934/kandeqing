<?xml version="1.0" encoding="utf-8"?>
<!-- 3.10：Logo 与球同构 —— 半透明矢量柔边环（径向渐变淡出），
     环内两条白色竖线。白色是默认，形态与「朗读态」一致，桌面上辨识度更高。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 柔边环：一个圆，用径向渐变做出「中间透明 + 周围渐变模糊」 -->
    <path
        android:pathData="M54,54m-40,0a40,40 0,1,0 80,0a40,40 0,1,0 -80,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42">
                <item android:offset="0.00" android:color="#00FFFFFF" />
                <item android:offset="0.48" android:color="#00FFFFFF" />
                <item android:offset="0.70" android:color="#E6FFFFFF" />
                <item android:offset="0.82" android:color="#80FFFFFF" />
                <item android:offset="0.94" android:color="#00FFFFFF" />
                <item android:offset="1.00" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 框里两条同色竖线 -->
    <path
        android:fillColor="#F2FFFFFF"
        android:pathData="M46,38h5v32h-5z M57,38h5v32h-5z" />

</vector>
