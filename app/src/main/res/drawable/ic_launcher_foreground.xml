<?xml version="1.0" encoding="utf-8"?>
<!-- 3.9：Logo 也改成「苹果白」—— 和默认球同一个图标结构：
     白圆 + 细灰边 + 中心小圆 + 北南西东四个小三角箭头。
     白圆上的符号用深灰，保证白色壁纸下也看得清。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 白色圆 -->
    <path
        android:fillColor="#FFFAFAFA"
        android:pathData="M54,54m-30,0a30,30 0,1,0 60,0a30,30 0,1,0 -60,0" />
    <!-- 细灰边，白色壁纸下不丢边界 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB4BDC9"
        android:strokeWidth="1.6"
        android:pathData="M54,54m-30,0a30,30 0,1,0 60,0a30,30 0,1,0 -60,0" />

    <!-- 十字杆 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF4C5765"
        android:strokeWidth="3"
        android:pathData="M54,48 L54,36 M54,60 L54,72 M48,54 L36,54 M60,54 L72,54" />

    <!-- 四个朝外的小三角 -->
    <path
        android:fillColor="#FF4C5765"
        android:pathData="M54,26 L49,36 L59,36 Z M54,82 L49,72 L59,72 Z M26,54 L36,49 L36,59 Z M82,54 L72,49 L72,59 Z" />

    <!-- 中心小圆（空心） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF4C5765"
        android:strokeWidth="3"
        android:pathData="M54,54m-6,0a6,6 0,1,0 12,0a6,6 0,1,0 -12,0" />

</vector>
