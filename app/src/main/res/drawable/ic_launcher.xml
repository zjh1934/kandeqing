<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 以下不支持 adaptive icon / 径向渐变矢量：
     简版白色环 + 两条白竖线，形态与高版本一致。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF1E1E1E" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item
        android:top="5dp" android:bottom="5dp"
        android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#FFFAFAFA" />
        </shape>
    </item>
    <item
        android:top="15dp" android:bottom="15dp"
        android:left="19dp" android:right="23dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFAFAFA" />
        </shape>
    </item>
    <item
        android:top="15dp" android:bottom="15dp"
        android:left="25dp" android:right="19dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFAFAFA" />
        </shape>
    </item>
</layer-list>
