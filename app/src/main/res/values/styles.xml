<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:colorAccent">@color/accent_solid</item>
        <item name="android:colorControlActivated">@color/accent_solid</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/surface_base</item>
        <item name="android:navigationBarColor">@color/surface_base</item>
    </style>

    <style name="AppThemeDark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_surface_base</item>
        <item name="android:colorAccent">@color/dark_accent_solid</item>
        <item name="android:colorControlActivated">@color/dark_accent_solid</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:statusBarColor">@color/dark_surface_base</item>
        <item name="android:navigationBarColor">@color/dark_surface_base</item>
    </style>
</resources>
