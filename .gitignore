# 构建产物
build/
**/build/
.gradle/
*.iml
local.properties

# 生成的 R 文件副本（留源码里的即可）
app/build/gen/
app/build/injected/
app/build/intermediate/
app/build/bin/

# 编辑器 / IDE 工具产物（不是工程源码）
settings.json
.idea/
.vscode/
*.swp
.DS_Store
.workbuddy/

# 手工构建脚本在 Linux / Actions 上用的本地工具链与临时产物
.toolchain/

# AOCI 认知资产：正式文件入库，运行时状态留在本地
.aoci/*
!.aoci/.gitignore
!.aoci/baseline.json
!.aoci/config.json
!.aoci/curation.json
